{
  "expo": {
    "name": "Ruth",
    "slug": "ruth-home-server",
    "scheme": "ruth",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0b0b0c"
    },
    "ios": {
      "bundleIdentifier": "gg.home.ruth",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow Ruth to connect to your home server on your local network or tailnet.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "gg.home.ruth",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "windowSoftInputMode": "adjustResize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0b0c"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "cf047b91-86f0-4388-a03f-a1718292b44a"
      }
    }
  }
}
