{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src"],
  // Cross-package pure-TS tests (run by vitest, which resolves them
  // directly): tsc must not compile them into dist (rootDir violation).
  "exclude": ["src/services/terminal/vtParser.test.ts"]
}
